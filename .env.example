# --- Server ---
PORT=3000
SESSION_SECRET=change-me-to-a-random-string

# --- LinkedIn Developer App ---
# Create an app at https://www.linkedin.com/developers/apps
# Products required: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
# Add the redirect URL below (matching REDIRECT_URI exactly) under the app's Auth tab.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback
# LinkedIn REST API version header, format YYYYMM. LinkedIn sunsets each version ~12 months
# after release, so this WILL need bumping periodically — if posts start failing with
# "Requested version ... is not active", check the "Latest Version" table at
# https://learn.microsoft.com/linkedin/marketing/versioning and update this.
LINKEDIN_API_VERSION=202607

# --- Gemini (optional, only needed for AI content planning) ---
# You can also paste this into the app's Settings page instead of here.
GEMINI_API_KEY=
