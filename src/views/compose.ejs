<div class="two-col">
  <div class="col">
    <div class="card">
      <h2>Compose a post</h2>
      <% if (!tokenStatus.connected || tokenStatus.expired) { %>
        <p class="hint">Connect your LinkedIn account in <a href="/settings">Settings</a> before posting.</p>
      <% } %>
      <form method="POST" action="/posts" id="composeForm">
        <label for="authorUrn">Post as</label>
        <select name="authorUrn" id="authorUrn">
          <option value="">Yourself<%= token && token.displayName ? ' (' + token.displayName + ')' : '' %></option>
          <% organizations.forEach(function(org) { %>
            <option value="<%= org.urn %>"><%= org.name %> (Company Page)</option>
          <% }); %>
        </select>
        <% if (!organizations.length) { %>
          <div class="hint">No company pages found. If you administer one, add it in <a href="/settings">Settings</a>.</div>
        <% } %>

        <label for="content">Post text</label>
        <textarea name="content" id="content" maxlength="3000" placeholder="What do you want to share?"></textarea>

        <label for="mediaPath">Image file path (optional)</label>
        <div style="display:flex; gap:8px;">
          <input type="text" name="mediaPath" id="mediaPath" placeholder="C:\Users\you\Desktop\photo.jpg" style="flex:1;">
          <button type="button" class="btn secondary" data-browse-for="#mediaPath">Browse…</button>
        </div>
        <div class="hint">Absolute path to a local jpg/png/gif on this machine. It's read at post time, so it just needs to exist by then.</div>

        <label for="visibility">Visibility</label>
        <select name="visibility" id="visibility">
          <option value="PUBLIC">Public</option>
          <option value="CONNECTIONS">Connections only</option>
        </select>

        <label for="scheduledFor">Schedule for (leave blank + use "Post Now" to publish immediately)</label>
        <input type="datetime-local" name="scheduledFor" id="scheduledFor">

        <div style="margin-top:16px; display:flex; gap:10px;">
          <button type="submit" name="action" value="schedule" class="btn secondary">Schedule</button>
          <button type="submit" name="action" value="now" class="btn">Post Now</button>
        </div>
      </form>
    </div>
  </div>
  <div class="col">
    <div class="card">
      <h2>Preview</h2>
      <div id="preview"></div>
    </div>
  </div>
</div>

<script src="/js/preview.js"></script>
<script src="/js/dashboard.js"></script>
<script>
  const personProfile = {
    name: <%- JSON.stringify(token ? token.displayName : null) %>,
    headline: <%- JSON.stringify(token ? token.headline : null) %>,
    avatarUrl: <%- JSON.stringify(token ? token.pictureUrl : null) %>,
  };
  const orgNamesByUrn = <%- JSON.stringify(Object.fromEntries(organizations.map(function(o) { return [o.urn, o.name]; }))) %>;
  const preview = LIPreview.mountPreview(document.getElementById('preview'), personProfile);
  const contentEl = document.getElementById('content');
  const mediaEl = document.getElementById('mediaPath');
  const authorEl = document.getElementById('authorUrn');
  function currentProfile() {
    const orgName = orgNamesByUrn[authorEl.value];
    return orgName ? { name: orgName, headline: 'Company Page', avatarUrl: null } : personProfile;
  }
  function refresh() { preview.update(contentEl.value, mediaEl.value, currentProfile()); }
  contentEl.addEventListener('input', refresh);
  mediaEl.addEventListener('input', refresh);
  authorEl.addEventListener('change', refresh);
  refresh();
</script>
