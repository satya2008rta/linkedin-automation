<div class="card">
  <h2>AI Content Calendar</h2>
  <p class="hint">Generates draft posts for your selected date range using your <a href="/settings">AI settings</a>. Drag and drop any post onto a new date to reschedule it — an 8-hour gap is automatically maintained between multiple posts on the same date!</p>
  <% if (!settings.geminiApiKey) { %>
    <p class="hint" style="color:#b31b1b;">No Gemini API key saved yet — add one in <a href="/settings">Settings</a> first.</p>
  <% } %>
  <form method="POST" action="/ai/generate-plan" style="display:flex; flex-wrap:wrap; gap:12px; align-items:flex-end; margin-top:12px;">
    <div>
      <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">From Date</label>
      <input type="date" name="fromDate" id="gen-from-date" class="form-control" style="padding:6px 10px; font-size:13px;">
    </div>
    <div>
      <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">To Date</label>
      <input type="date" name="toDate" id="gen-to-date" class="form-control" style="padding:6px 10px; font-size:13px;">
    </div>
    <div>
      <button type="submit" class="btn" <%= settings.geminiApiKey ? '' : 'disabled' %>>Generate plan for date range</button>
    </div>
  </form>
</div>

<!-- Outlook Style Interactive Monthly Calendar -->
<div class="outlook-calendar">
  <div class="outlook-header">
    <div class="outlook-title">
      <span id="cal-month-title">Calendar</span>
      <div style="display:inline-flex; gap:6px; margin-left:12px;">
        <button type="button" class="btn secondary" id="prev-month-btn" style="padding:4px 10px; font-size:12px;">&larr; Prev</button>
        <button type="button" class="btn secondary" id="today-btn" style="padding:4px 10px; font-size:12px;">Today</button>
        <button type="button" class="btn secondary" id="next-month-btn" style="padding:4px 10px; font-size:12px;">Next &rarr;</button>
      </div>
    </div>
    <div class="outlook-legend">
      <span class="legend-item"><span class="legend-dot posted"></span> Posted</span>
      <span class="legend-item"><span class="legend-dot pending"></span> Queued</span>
      <span class="legend-item"><span class="legend-dot draft"></span> AI Draft</span>
      <span class="legend-item"><span class="legend-dot failed"></span> Failed</span>
    </div>
  </div>

  <div class="outlook-grid" id="outlook-calendar-grid">
    <!-- Rendered via JavaScript -->
  </div>
</div>

<div class="card" style="margin-top: 24px;">
  <h2>AI Drafts Review</h2>
  <p class="hint">Review and edit generated drafts below before approving them into your queue.</p>
</div>

<% if (!days.length) { %>
  <div class="card"><p class="hint">No AI drafts awaiting review yet. Select a date range and generate a plan above.</p></div>
<% } %>

<% days.forEach(function(day) { %>
  <div class="calendar-day">
    <div class="calendar-day-date"><%= day %></div>
    <% byDate[day].forEach(function(draft) { %>
      <div class="two-col" id="draft-<%= draft.id %>" style="margin-bottom:18px; padding-bottom:18px; border-bottom:1px solid var(--border); scroll-margin-top: 20px;">
        <div class="col">
          <p class="hint" style="margin-top:0;">Last saved <%= friendlyDate(draft.updatedAt) %></p>
          <form method="POST" action="/ai/drafts/<%= draft.id %>/update" class="draft-form" data-id="<%= draft.id %>">
            <div style="display:flex; justify-content:space-between; align-items:center; margin:12px 0 4px;">
              <label style="margin:0;">Content</label>
              <button type="button" class="btn secondary" style="padding:2px 10px; font-size:12px;"
                      data-ai-rewrite-for="#draft-content-<%= draft.id %>"
                      <%= settings.geminiApiKey ? '' : 'disabled title="Add a Gemini API key in Settings first"' %>>✨ Rewrite with AI</button>
            </div>
            <textarea name="content" id="draft-content-<%= draft.id %>" class="draft-content"><%= draft.content %></textarea>
            <label>Image file path (optional)</label>
            <div style="display:flex; gap:8px;">
              <input type="text" name="mediaPath" id="draft-media-<%= draft.id %>" class="draft-media" value="<%= draft.mediaPath || '' %>" placeholder="C:\Users\you\Desktop\photo.jpg" style="flex:1;">
              <button type="button" class="btn secondary" data-browse-for="#draft-media-<%= draft.id %>">Browse…</button>
            </div>
            <div class="hint">Attach a local jpg/png/gif — read at post time, same as Compose. Leave blank for a text-only post.</div>
            <label>Scheduled for</label>
            <input type="datetime-local" name="scheduledFor" class="draft-scheduled" value="<%= isoToLocalInput(draft.scheduledFor) %>">
            <div style="margin-top:10px; display:flex; gap:8px;">
              <button type="submit" formaction="/ai/drafts/<%= draft.id %>/update" class="btn secondary">Save edits</button>
              <button type="submit" formaction="/ai/drafts/<%= draft.id %>/approve" class="btn">Approve</button>
              <button type="submit" formaction="/ai/drafts/<%= draft.id %>/discard" class="btn danger" data-confirm="Discard this draft?">Discard</button>
            </div>
          </form>
        </div>
        <div class="col">
          <div class="draft-preview" data-id="<%= draft.id %>"></div>
        </div>
      </div>
    <% }); %>
  </div>
<% }); %>

<!-- Event Detail Modal -->
<div id="event-modal" class="modal-overlay" style="display:none;">
  <div class="modal-card">
    <span class="modal-close" onclick="closeEventModal()">&times;</span>
    <h3 id="modal-title" style="margin-top:0;">Post Details</h3>
    <div id="modal-status-badge" style="margin-bottom:12px;"></div>
    <div id="modal-date" class="hint" style="margin-bottom:4px;"></div>
    <div id="modal-last-saved" class="hint" style="margin-bottom:12px;"></div>

    <form id="modal-post-form" method="POST" action="">
      <input type="hidden" name="scheduledFor" id="modal-scheduled-input">
      
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
        <label style="display:block; font-size:12px; font-weight:600; margin:0;">Post Content</label>
        <button type="button" class="btn secondary" id="modal-ai-rewrite-btn" style="padding:2px 10px; font-size:12px;"
                data-ai-rewrite-for="#modal-content-input"
                <%= settings.geminiApiKey ? '' : 'disabled title="Add a Gemini API key in Settings first"' %>>✨ Rewrite with AI</button>
      </div>
      <textarea id="modal-content-input" name="content" style="width:100%; min-height:90px; font-size:14px; margin-bottom:12px; padding:8px; border:1px solid #c7c7c7; border-radius:4px; font-family:inherit;"></textarea>

      <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Image file path (optional)</label>
      <div style="display:flex; gap:8px; margin-bottom:16px;">
        <input type="text" id="modal-media-input" name="mediaPath" placeholder="C:\Users\you\Desktop\photo.jpg" style="flex:1; font-size:13px; padding:8px; border:1px solid #c7c7c7; border-radius:4px;">
        <button type="button" class="btn secondary" data-browse-for="#modal-media-input" style="padding:6px 12px; font-size:13px;">Browse…</button>
      </div>

      <div id="modal-actions" style="display:flex; gap:8px; flex-wrap:wrap; margin-top:16px;"></div>
    </form>
  </div>
</div>

<!-- Shared "AI Rewrite" modal, targeted per-click via data-ai-rewrite-for on each ✨ button.
     Higher z-index than both .modal-overlay (9999) and .toast-notification (10000) since it
     can be opened from inside the already-open Event Detail Modal above. -->
<div id="ai-rewrite-modal" class="modal-overlay" style="display:none; z-index:10050;">
  <div class="modal-card">
    <span class="modal-close">&times;</span>
    <h3 id="ai-rewrite-heading" style="margin-top:0;">✨ Rewrite with AI</h3>
    <p class="hint" id="ai-rewrite-hint">Describe what you want changed — e.g. "make this more concise", "add a call to action", "make it sound more casual".</p>
    <textarea id="ai-rewrite-instruction" placeholder="What should change?" style="min-height:70px;"></textarea>
    <div id="ai-rewrite-error" style="color:#b31b1b; font-size:12px; margin-top:6px;"></div>
    <div style="margin-top:14px; display:flex; gap:8px;">
      <button type="button" class="btn" id="ai-rewrite-submit">Rewrite</button>
      <button type="button" class="btn secondary" id="ai-rewrite-cancel">Cancel</button>
    </div>
  </div>
</div>

<script src="/js/preview.js"></script>
<script src="/js/dashboard.js"></script>
<script>
  const profile = {
    name: <%- JSON.stringify(token ? token.displayName : null) %>,
    headline: <%- JSON.stringify(token ? token.headline : null) %>,
    avatarUrl: <%- JSON.stringify(token ? token.pictureUrl : null) %>,
  };

  const allPosts = <%- JSON.stringify(allPosts || []) %>;
  window.allPosts = allPosts; // Expose globally for 8-hour proximity check

  let currentYear = <%= year %>;
  let currentMonth = <%= month %>; // 1-based (1 = Jan, 8 = Aug)

  const monthNames = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December'
  ];

  // Set default From and To dates for plan generation
  const todayStr = new Date().toISOString().slice(0, 10);
  const thirtyDaysStr = new Date(Date.now() + 30 * 86400000).toISOString().slice(0, 10);
  const fromDateEl = document.getElementById('gen-from-date');
  const toDateEl = document.getElementById('gen-to-date');
  if (fromDateEl && !fromDateEl.value) fromDateEl.value = todayStr;
  if (toDateEl && !toDateEl.value) toDateEl.value = thirtyDaysStr;

  function getPostDateKey(post) {
    const raw = post.postedAt || post.scheduledFor || post.createdAt;
    if (!raw) return '';
    const d = new Date(raw);
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  let draggedPostId = null;

  function handleDragStart(e, postId) {
    draggedPostId = postId;
    e.dataTransfer.setData('text/plain', postId);
    e.dataTransfer.effectAllowed = 'move';
    e.target.classList.add('dragging');
  }

  function handleDragEnd(e) {
    e.target.classList.remove('dragging');
    document.querySelectorAll('.outlook-day-cell').forEach(cell => cell.classList.remove('drag-over'));
  }

  function handleDragOver(e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
  }

  function handleDragEnter(e) {
    e.preventDefault();
    const cell = e.target.closest('.outlook-day-cell');
    if (cell) cell.classList.add('drag-over');
  }

  function handleDragLeave(e) {
    const cell = e.target.closest('.outlook-day-cell');
    if (cell) cell.classList.remove('drag-over');
  }

  async function handleDrop(e, targetDateStr) {
    e.preventDefault();
    const cell = e.target.closest('.outlook-day-cell');
    if (cell) cell.classList.remove('drag-over');

    if (!draggedPostId || !targetDateStr) return;

    const postId = draggedPostId;
    const post = allPosts.find(p => p.id === postId);
    if (!post) return;

    const oldDateKey = getPostDateKey(post);
    if (oldDateKey === targetDateStr) return;

    try {
      const res = await fetch(`/posts/${postId}/reschedule-date`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ newDate: targetDateStr })
      });

      if (!res.ok) {
        const err = await res.json();
        throw new Error(err.error || 'Failed to reschedule post.');
      }

      const data = await res.json();
      if (data.ok && data.post) {
        post.scheduledFor = data.newScheduledFor;
        renderOutlookCalendar(currentYear, currentMonth);

        const friendlyTime = new Date(data.newScheduledFor).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        showToast(`Rescheduled to ${targetDateStr} at ${friendlyTime} (8-hour spacing maintained)`);
      }
    } catch (err) {
      alert('Reschedule error: ' + err.message);
    } finally {
      draggedPostId = null;
    }
  }

  function showToast(msg) {
    let toast = document.getElementById('toast-msg');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'toast-msg';
      toast.className = 'toast-notification';
      document.body.appendChild(toast);
    }
    toast.textContent = '✓ ' + msg;
    toast.style.display = 'block';
    setTimeout(() => { toast.style.display = 'none'; }, 4000);
  }

  function renderOutlookCalendar(year, month) {
    const grid = document.getElementById('outlook-calendar-grid');
    const title = document.getElementById('cal-month-title');
    title.textContent = `${monthNames[month - 1]} ${year}`;

    const postsByDate = {};
    allPosts.forEach(p => {
      const key = getPostDateKey(p);
      if (key) {
        (postsByDate[key] = postsByDate[key] || []).push(p);
      }
    });

    const firstDayIndex = new Date(year, month - 1, 1).getDay();
    const daysInMonth = new Date(year, month, 0).getDate();
    const daysInPrevMonth = new Date(year, month - 1, 0).getDate();

    let html = '';
    const dayHeaders = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    dayHeaders.forEach(dh => {
      html += `<div class="outlook-day-header">${dh}</div>`;
    });

    const now = new Date();
    const currTodayStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    const totalCells = Math.ceil((firstDayIndex + daysInMonth) / 7) * 7;

    for (let i = 0; i < totalCells; i++) {
      let dayNum, isOtherMonth = false, cellYear = year, cellMonth = month;
      if (i < firstDayIndex) {
        dayNum = daysInPrevMonth - firstDayIndex + i + 1;
        isOtherMonth = true;
        cellMonth = month - 1;
        if (cellMonth === 0) { cellMonth = 12; cellYear--; }
      } else if (i >= firstDayIndex + daysInMonth) {
        dayNum = i - (firstDayIndex + daysInMonth) + 1;
        isOtherMonth = true;
        cellMonth = month + 1;
        if (cellMonth === 13) { cellMonth = 1; cellYear++; }
      } else {
        dayNum = i - firstDayIndex + 1;
      }

      const dateStr = `${cellYear}-${String(cellMonth).padStart(2, '0')}-${String(dayNum).padStart(2, '0')}`;
      const isToday = dateStr === currTodayStr;
      const dayPosts = postsByDate[dateStr] || [];

      html += `<div class="outlook-day-cell ${isOtherMonth ? 'other-month' : ''} ${isToday ? 'today' : ''}" `;
      html += `data-date="${dateStr}" ondragover="handleDragOver(event)" ondragenter="handleDragEnter(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event, '${dateStr}')">`;
      html += `<div class="outlook-day-number">${dayNum}</div>`;
      html += `<div class="outlook-events">`;

      dayPosts.forEach(p => {
        let labelIcon = '📝';
        if (p.status === 'posted') labelIcon = '✓';
        else if (p.status === 'pending') labelIcon = '⏳';
        else if (p.status === 'failed' || p.status === 'blocked_token_expired') labelIcon = '⚠';

        const snippet = p.content.length > 22 ? p.content.slice(0, 22) + '…' : p.content;
        html += `<div class="event-pill ${p.status}" draggable="true" ondragstart="handleDragStart(event, ${p.id})" ondragend="handleDragEnd(event)" onclick="openEventModal(${p.id})" title="Drag onto any date cell to reschedule">${labelIcon} ${snippet}</div>`;
      });

      html += `</div></div>`;
    }

    grid.innerHTML = html;
  }

  document.getElementById('prev-month-btn').addEventListener('click', () => {
    currentMonth--;
    if (currentMonth === 0) { currentMonth = 12; currentYear--; }
    renderOutlookCalendar(currentYear, currentMonth);
  });

  document.getElementById('next-month-btn').addEventListener('click', () => {
    currentMonth++;
    if (currentMonth === 13) { currentMonth = 1; currentYear++; }
    renderOutlookCalendar(currentYear, currentMonth);
  });

  document.getElementById('today-btn').addEventListener('click', () => {
    const n = new Date();
    currentYear = n.getFullYear();
    currentMonth = n.getMonth() + 1;
    renderOutlookCalendar(currentYear, currentMonth);
  });

  function openEventModal(postId) {
    const post = allPosts.find(p => p.id === postId);
    if (!post) return;

    document.getElementById('modal-title').textContent = post.status.toUpperCase() + ' POST';
    document.getElementById('modal-status-badge').innerHTML = `<span class="status-pill ${post.status}">${post.status.replace('_',' ')}</span>`;
    const dateStr = post.postedAt ? `Posted: ${new Date(post.postedAt).toLocaleString()}` : `Scheduled: ${new Date(post.scheduledFor || post.createdAt).toLocaleString()}`;
    document.getElementById('modal-date').textContent = dateStr;
    document.getElementById('modal-last-saved').textContent = post.updatedAt ? `Last saved: ${new Date(post.updatedAt).toLocaleString()}` : '';

    const form = document.getElementById('modal-post-form');
    form.dataset.id = post.id;
    const contentInput = document.getElementById('modal-content-input');
    const mediaInput = document.getElementById('modal-media-input');
    const scheduledInput = document.getElementById('modal-scheduled-input');

    contentInput.value = post.content || '';
    mediaInput.value = post.mediaPath || '';
    scheduledInput.value = post.scheduledFor || post.createdAt || '';

    // A posted post has no Save action in this modal (view-only), so rewriting its text
    // here would be a dead end — hide the trigger rather than let it edit toward nowhere.
    const aiRewriteBtn = document.getElementById('modal-ai-rewrite-btn');
    if (aiRewriteBtn) aiRewriteBtn.style.display = post.status === 'posted' ? 'none' : '';

    let actionsHtml = '';
    if (post.status === 'draft') {
      form.action = `/ai/drafts/${post.id}/approve`;
      actionsHtml += `<button class="btn" type="submit" formaction="/ai/drafts/${post.id}/approve" data-id="${post.id}">Approve Draft</button>`;
      actionsHtml += `<button class="btn secondary" type="submit" formaction="/ai/drafts/${post.id}/update" data-id="${post.id}">Save Edits</button>`;
      actionsHtml += `<button class="btn danger" type="submit" formaction="/ai/drafts/${post.id}/discard" data-id="${post.id}" data-confirm="Discard this draft?">Discard</button>`;
    } else if (post.status === 'pending' || post.status === 'failed' || post.status === 'blocked_token_expired') {
      form.action = `/posts/${post.id}/update`;
      actionsHtml += `<button class="btn" type="submit" formaction="/posts/${post.id}/post-now" data-id="${post.id}" data-confirm="Publish to LinkedIn right now?">Post Now</button>`;
      actionsHtml += `<button class="btn secondary" type="submit" formaction="/posts/${post.id}/update" data-id="${post.id}">Save Edits</button>`;
      actionsHtml += `<button class="btn danger" type="submit" formaction="/posts/${post.id}/cancel" data-id="${post.id}" data-confirm="Cancel this post?">Cancel</button>`;
    } else if (post.status === 'posted' && post.linkedinPostUrl) {
      actionsHtml += `<a href="${post.linkedinPostUrl}" target="_blank" rel="noopener" class="btn secondary">View on LinkedIn &nearr;</a>`;
    }

    document.getElementById('modal-actions').innerHTML = actionsHtml;
    document.getElementById('event-modal').style.display = 'flex';
  }

  function closeEventModal() {
    document.getElementById('event-modal').style.display = 'none';
  }

  // Initial calendar render
  renderOutlookCalendar(currentYear, currentMonth);

  // Mount draft previews
  document.querySelectorAll('.draft-preview').forEach(function (container) {
    const id = container.dataset.id;
    const form = document.querySelector('.draft-form[data-id="' + id + '"]');
    if (!form) return;
    const contentEl = form.querySelector('.draft-content');
    const mediaEl = form.querySelector('.draft-media');
    const preview = LIPreview.mountPreview(container, profile);
    function refresh() { preview.update(contentEl.value, mediaEl.value); }
    contentEl.addEventListener('input', refresh);
    mediaEl.addEventListener('input', refresh);
    refresh();
  });
</script>
