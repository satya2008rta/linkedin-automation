<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' · LinkedIn Automation' : 'LinkedIn Automation' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-shell">
    <div class="sidebar">
      <h1>LinkedIn Automation</h1>
      
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <div class="user-switcher-container">
          <label for="userSwitcherSelect" class="switcher-label">Acting as User:</label>
          <form method="POST" action="/auth/switch-user" id="userSwitcherForm">
            <select name="targetUserId" id="userSwitcherSelect" onchange="document.getElementById('userSwitcherForm').submit()">
              <% if (allUsers && allUsers.length > 0) { %>
                <% allUsers.forEach(function(u) { %>
                  <option value="<%= u.id %>" <%= (currentUser && currentUser.id === u.id) ? 'selected' : '' %>>
                    <%= u.displayName || u.email || ('User #' + u.id) %> <%= (adminUser && adminUser.id === u.id) ? '(Admin)' : '' %>
                  </option>
                <% }); %>
              <% } else if (currentUser) { %>
                <option value="<%= currentUser.id %>" selected><%= currentUser.displayName || 'Admin' %></option>
              <% } %>
            </select>
          </form>
          <a href="/auth/invite-link" class="invite-client-btn">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
            + Invite / Share Link
          </a>
        </div>
      <% } %>

      <nav>
        <a href="/" class="<%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/compose" class="<%= active === 'compose' ? 'active' : '' %>">Compose</a>
        <a href="/queue" class="<%= active === 'queue' ? 'active' : '' %>">Queue</a>
        <a href="/posted" class="<%= active === 'posted' ? 'active' : '' %>">Posted</a>
        <a href="/calendar" class="<%= active === 'calendar' ? 'active' : '' %>">AI Calendar</a>
        <a href="/engage" class="<%= active === 'engage' ? 'active' : '' %>">Engage</a>
        <a href="/settings" class="<%= active === 'settings' ? 'active' : '' %>">Settings</a>
      </nav>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <%
          const dotClass = !tokenStatus.connected || tokenStatus.expired ? 'red'
            : (tokenStatus.daysRemaining <= 14 ? 'amber' : null);
          const subLabel = !tokenStatus.connected ? 'Not connected'
            : tokenStatus.expired ? 'Token expired'
            : `Connected · ${tokenStatus.daysRemaining}d left`;
          const initial = (currentUser.displayName || '?').trim().charAt(0).toUpperCase();
        %>
        <div class="account-chip">
          <div class="account-avatar" style="<%= currentUser.pictureUrl ? `background-image:url('${currentUser.pictureUrl}')` : '' %>">
            <%= currentUser.pictureUrl ? '' : initial %>
            <% if (dotClass) { %><span class="account-status-dot <%= dotClass %>"></span><% } %>
          </div>
          <div class="account-meta">
            <div class="account-name" title="<%= currentUser.displayName %>"><%= currentUser.displayName || 'Signed in' %></div>
            <div class="account-sub"><%= subLabel %></div>
          </div>
          <form method="POST" action="/auth/logout" title="Sign out admin">
            <button class="account-signout" type="submit" aria-label="Sign out">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </button>
          </form>
        </div>
      <% } %>
    </div>
    <div class="main">
      <% if (messages.error && messages.error.length) { %>
        <% messages.error.forEach(function(m) { %><div class="flash error"><%= m %></div><% }); %>
      <% } %>
      <% if (messages.success && messages.success.length) { %>
        <% messages.success.forEach(function(m) { %><div class="flash success"><%= m %></div><% }); %>
      <% } %>
      <%- body %>
    </div>
  </div>
</body>
</html>
