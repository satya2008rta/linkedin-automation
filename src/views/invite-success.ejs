<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LinkedIn Connected</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-body">
  <div class="login-wrap">
    <div class="login-card">
      <div class="login-brand">
        <div class="login-mark">in</div>
        <span class="login-brand-name">LinkedIn Automation</span>
      </div>
      <div style="font-size: 48px; margin-bottom: 12px;">✅</div>
      <h1 class="login-headline">You're all set, <%= userName %>!</h1>
      <p class="login-sub">
        Your LinkedIn account has been successfully connected to the automation dashboard. Posts will be scheduled and managed on your behalf — no further action or login required from you.
      </p>
      <div class="flash success" style="text-align: center; margin-top: 20px;">
        You can close this tab now.
      </div>
    </div>
  </div>
</body>
</html>
